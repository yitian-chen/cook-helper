# Copy to .env. Never commit the real file.
# Independent selection: aliyun or xfyun. Missing values keep the tested Aliyun default.
ASR_PROVIDER=aliyun
TTS_PROVIDER=aliyun
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE=
DASHSCOPE_REGION=cn-beijing
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v3-plus
TTS_VOICE=longanyang
# XFYun: enable IAT v2 + online TTS v2 in the console, NOT Spark credentials.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_TTS_VOICE=xiaoyan
XFYUN_TTS_SPEED=50
XFYUN_TTS_VOLUME=50
XFYUN_TTS_PITCH=50
# Optional per-service credentials override the shared XFYUN_* values when nonempty.
XFYUN_ASR_APP_ID=
XFYUN_ASR_API_KEY=
XFYUN_ASR_API_SECRET=
XFYUN_TTS_APP_ID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
# integer device ID, exact unambiguous device-name substring, or blank for default
INPUT_DEVICE=
OUTPUT_DEVICE=
RECORD_SAMPLE_RATE=16000
MAX_RECORD_SECONDS=20
CLOUD_TIMEOUT_SECONDS=45
# mock is ONLY an integration placeholder; http connects to your teammate's Agent.
AGENT_MODE=mock
AGENT_URL=http://127.0.0.1:9000/agent
AGENT_TOKEN=
AGENT_TIMEOUT_SECONDS=30
